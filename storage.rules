rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return isSignedIn() && profile().role == role;
    }

    function canManageSchoolPosts() {
      return hasRole('admin') || hasRole('teacher');
    }

    function isSafeImage(maxSizeBytes) {
      return request.resource != null
        && request.resource.size < maxSizeBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Legacy flat-path uploads are intentionally read-only for signed-in users
    // and blocked for writes; current clients must use profile_pictures/{uid}/.
    match /profile_pictures/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if false;
    }

    match /secretariat_posts/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if canManageSchoolPosts()
        && isSafeImage(8 * 1024 * 1024);
      allow delete: if hasRole('admin');
    }
  }
}
